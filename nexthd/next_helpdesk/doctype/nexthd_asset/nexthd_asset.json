   "label": "Warranty Until"
  },
  {
   "fieldname": "section_pc",
   "fieldtype": "Section Break",
   "label": "Catatan PC/Laptop/Server",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)",
   "collapsible": 0
  },
  {
   "fieldname": "peripheral_notes",
   "fieldtype": "Small Text",
   "label": "Remarks / Catatan",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)",
   "placeholder": "e.g. Monitor 24inch, Keyboard, Mouse, UPS"
  },
  {
   "fieldname": "section_network",
   "fieldtype": "Section Break",
   "label": "Catatan Network Device",
   "depends_on": "eval:doc.asset_type == 'Network Device'",
   "collapsible": 0
  },
  {
   "fieldname": "net_notes",
   "fieldtype": "Small Text",
   "label": "Catatan",
   "depends_on": "eval:doc.asset_type == 'Network Device'"
  },
  {
   "fieldname": "section_printer",
   "fieldtype": "Section Break",
   "label": "Catatan Printer",
   "depends_on": "eval:doc.asset_type == 'Printer'",
   "collapsible": 0
  },
  {
   "fieldname": "printer_notes",
   "fieldtype": "Small Text",
   "label": "Catatan",
   "depends_on": "eval:doc.asset_type == 'Printer'"
  },
  {
   "fieldname": "section_lainnya",
   "fieldtype": "Section Break",
   "label": "Keterangan",
   "depends_on": "eval:doc.asset_type == 'Lainnya'",
