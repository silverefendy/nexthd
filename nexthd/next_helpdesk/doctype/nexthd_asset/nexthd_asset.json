 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Naming Series",
   "options": "AST-.YY.MM.-.####"
  },
  {
   "fieldname": "asset_name",
   "fieldtype": "Data",
   "label": "Asset Name",
   "reqd": 1
  },
  {
   "fieldname": "asset_type",
   "fieldtype": "Select",
   "label": "Asset Type",
   "options": "Laptop\nPC\nServer\nNetwork Device\nPrinter\nLainnya",
   "reqd": 1
  },
  {
   "fieldname": "location",
   "fieldtype": "Data",
   "label": "Location"
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "label": "Assigned To",
   "options": "User"
  },
  {
   "default": "Aktif",
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Aktif\nRusak\nDiperbaiki\nDihapus",
   "reqd": 1
  },
  {
   "fieldname": "purchase_date",
   "fieldtype": "Date",
   "label": "Purchase Date"
  },
  {
   "fieldname": "warranty_until",
   "fieldtype": "Date",
   "label": "Warranty Until"
  },
  {
   "fieldname": "section_pc",
   "fieldtype": "Section Break",
   "label": "Spesifikasi Hardware",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)",
   "collapsible": 0
  },
  {
   "fieldname": "brand",
   "fieldtype": "Data",
   "label": "Brand",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)"
  },
  {
   "fieldname": "model",
   "fieldtype": "Data",
   "label": "Model",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)"
  },
  {
   "fieldname": "serial_number",
   "fieldtype": "Data",
   "label": "Serial Number",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)"
  },
  {
   "fieldname": "col_pc1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cpu",
   "fieldtype": "Data",
   "label": "CPU",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)",
   "placeholder": "e.g. Intel Core i5-12400"
  },
  {
   "fieldname": "ram",
   "fieldtype": "Data",
   "label": "RAM",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)",
   "placeholder": "e.g. 16GB DDR4"
  },
  {
   "fieldname": "col_pc2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "storage",
   "fieldtype": "Data",
   "label": "Storage",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)",
   "placeholder": "e.g. 512GB SSD + 1TB HDD"
  },
  {
   "fieldname": "os",
   "fieldtype": "Select",
   "label": "Operating System",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)",
   "options": "\nWindows 10\nWindows 11\nWindows Server 2019\nWindows Server 2022\nUbuntu\nDebian\nCentOS\nLainnya"
  },
  {
   "fieldname": "peripheral_notes",
   "fieldtype": "Small Text",
   "label": "Peripheral / Catatan",
   "depends_on": "eval:in_list(['Laptop','PC','Server'], doc.asset_type)",
   "placeholder": "e.g. Monitor 24inch, Keyboard, Mouse, UPS"
